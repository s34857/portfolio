 /* เลเยอร์ทรานซิชั่นเส้นสีม่วงวิ่งตัดหน้าจอแบบเฟี้ยวๆ */
        .page-transition-overlay {
            position: fixed;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #4A154B, #2b1b3d);
            z-index: 9999;
            pointer-events: none;
            transition: none;
        }

        .page-transition-overlay.animate {
            animation: swipeTransition 0.6s cubic-bezier(0.77, 0, 0.175, 1) forwards;
        }

        @keyframes swipeTransition {
            0% { left: -100%; }
            50% { left: 0%; }
            100% { left: 100%; }
        }

        .pol-banner {
            background: linear-gradient(135deg, #4A154B, #2b1b3d);
            color: #f3e5f5;
            padding: 12px 25px;
            border-radius: 12px;
            font-size: 0.95rem;
            margin-bottom: 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 5px 15px rgba(74, 21, 75, 0.2);
            position: relative;
            overflow: hidden;
        }

        .pol-banner::after {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: linear-gradient(to right, rgba(255,255,255,0), rgba(255,255,255,0.08), rgba(255,255,255,0));
            transform: rotate(30deg);
            animation: bannerShine 6s infinite linear;
        }

        @keyframes bannerShine {
            0% { transform: translateX(-100%) rotate(30deg); }
            100% { transform: translateX(100%) rotate(30deg); }
        }

        .pol-banner span {
            font-weight: 500;
            letter-spacing: 0.5px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .scale-icon-banner {
            width: 28px;
            height: 28px;
            object-fit: contain;
            animation: scalePulse 3s infinite ease-in-out;
        }

        @keyframes scalePulse {
            0%, 100% { transform: scale(1); filter: drop-shadow(0 0 2px rgba(255,255,255,0.4)); }
            50% { transform: scale(1.1); filter: drop-shadow(0 0 8px rgba(255,215,0,0.8)); }
        }

        .page {
            display: none;
        }

        .page.active {
            display: block;
            animation: pageFadeIn 0.5s ease-out forwards;
        }

        @keyframes pageFadeIn {
            from { opacity: 0; transform: scale(0.98); }
            to { opacity: 1; transform: scale(1); }
        }

        .header-title {
            text-align: right;
            font-size: 3rem;
            font-weight: 600;
            color: #2b1b3d;
            margin-bottom: 15px;
            font-style: italic;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.05);
        }

        .content-grid {
            display: grid;
            grid-template-columns: 300px 1fr;
            gap: 40px;
            align-items: start;
        }

        .profile-sidebar {
            text-align: center;
        }

        .profile-img {
            width: 180px;
            height: 180px;
            border-radius: 50%;
            object-fit: cover;
            border: 4px solid #fff;
            box-shadow: 0 8px 20px rgba(0,0,0,0.15);
            margin-bottom: 15px;
            transition: transform 0.3s ease;
        }

        .profile-img:hover {
            transform: scale(1.03) rotate(2deg);
        }

        .profile-name {
            font-size: 1.2rem;
            font-weight: 600;
            color: #333;
        }

        .profile-quote {
            font-size: 0.95rem;
            color: #666;
            margin-top: 5px;
        }

        .trophy-section {
            margin-top: 30px;
            text-align: center;
        }

        .trophy-section p {
            font-weight: 600;
            margin-bottom: 12px;
            color: #2b1b3d;
        }

        .trophy-btn {
            background: none;
            border: none;
            cursor: pointer;
            position: relative;
            padding: 10px;
            border-radius: 50%;
            transition: all 0.3s ease;
        }

        .trophy-btn::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255,215,0,0.5) 0%, rgba(255,255,255,0) 70%);
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: 0;
        }

        .trophy-btn:hover::before {
            opacity: 1;
            animation: trophyGlow 1.5s infinite alternate;
        }

        @keyframes trophyGlow {
            from { transform: scale(1); opacity: 0.6; }
            to { transform: scale(1.25); opacity: 1; }
        }

        .trophy-btn:hover {
            transform: translateY(-5px) scale(1.1);
        }

        .trophy-icon {
            width: 85px;
            height: 85px;
            object-fit: contain;
            position: relative;
            z-index: 1;
            filter: drop-shadow(0 5px 8px rgba(0,0,0,0.15));
        }

        .info-box {
            background: #fff;
            border-radius: 14px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 6px 18px rgba(0,0,0,0.06);
            position: relative;
            border-left: 5px solid #4A154B;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .info-box:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(74, 21, 75, 0.1);
        }

        .box-title-container {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
        }

        .purple-tag {
            background-color: #4A154B;
            color: white;
            padding: 8px 22px;
            border-radius: 20px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 4px 10px rgba(74, 21, 75, 0.25);
        }

        .purple-tag img {
            width: 20px;
            height: 20px;
        }

        .info-box p {
            font-size: 0.95rem;
            line-height: 1.6;
            color: #444;
            margin-bottom: 10px;
        }

        .info-box ul {
            list-style-type: none;
            padding-left: 10px;
        }

        .info-box ul li {
            font-size: 0.95rem;
            margin-bottom: 8px;
            color: #555;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: transform 0.2s;
        }

        .info-box ul li:hover {
            transform: translateX(5px);
            color: #2b1b3d;
        }

        .nav-menu-bar {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            margin-bottom: 35px;
            flex-wrap: wrap;
        }

        .nav-btn {
            background-color: #fff;
            color: #4A154B;
            border: 2px solid #4A154B;
            padding: 10px 22px;
            border-radius: 30px;
            cursor: pointer;
            font-size: 0.95rem;
            font-weight: 600;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
            transition: all 0.3s ease;
        }

        .nav-btn:hover {
            background-color: #4A154B;
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(74, 21, 75, 0.3);
        }

        .nav-btn.active-tab {
            background-color: #4A154B;
            color: #fff;
            box-shadow: 0 6px 15px rgba(74, 21, 75, 0.30);
        }

        .certificates-list {
            display: flex;
            flex-direction: column;
            gap: 35px;
            margin-top: 20px;
            align-items: center;
        }

        .cert-row-card {
            background: white;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 8px 25px rgba(0,0,0,0.08);
            width: 100%;
            max-width: 750px;
            border: 1px solid #eaeaea;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            animation: cardAppear 0.6s ease backwards;
        }

        .cert-row-card:nth-child(1) { animation-delay: 0.1s; }
        .cert-row-card:nth-child(2) { animation-delay: 0.2s; }
        .cert-row-card:nth-child(3) { animation-delay: 0.3s; }
        .cert-row-card:nth-child(4) { animation-delay: 0.4s; }

        @keyframes cardAppear {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .cert-row-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.12);
            border-color: rgba(74, 21, 75, 0.3);
        }

